{
  "name": "snapcon",
  "version": "2026.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezeitoun/SnapCon.git"
  },
  "private": true,
  "type": "commonjs",
  "bin": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "bench:utilization": "node scripts/bench-utilization.js",
    "test:update-golden": "node test/fixtures/card-golden/regenerate.js",
    "build": "pkg . --targets node22-win-x64,node22-macos-x64,node22-macos-arm64,node22-linux-x64 --out-path dist --no-bytecode --public"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "parser.js",
      "locales-default/**/*",
      "fixtures/virtual-u1/captures/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-linux-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "library/indexer-worker.js",
      "netfs/netfs-worker.js",
      "utilization/checkpoint-worker.js"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}

# Copy to .env (next to docker-compose.yml) and adjust. All optional.

# Time zone for log and audit-trail timestamps (tz database name).
TZ=Europe/Berlin

# Build the image with ffmpeg (still frames from Bambu Lab cameras for
# snapshots and notification images). false = smaller image; the live
# camera view works either way. Rebuild after changing: docker compose up -d --build
SNAPCON_WITH_FFMPEG=true

# Docker Desktop override only (docker-compose.desktop.yml): the port on your
# computer that opens the dashboard. With host networking (Linux) the port is
# config.json's "port" (default 4545) instead.
SNAPCON_PORT=4545

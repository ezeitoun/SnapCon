{
  "comment": "Targeted contract for GET /api/snapshot (docs/refactoring-policy.md). Printers: 0 Alpha (everyone), 1 Bravo (grp_staff only), 2 Charlie (offline). Users: admin; viewer (no groups = Everyone). LIMITATION: every fixture printer is a klipper-moonraker printer, and that connector has no getCameraSnapshot, so getSnapshot() refuses before anything is asked of a printer: the 200 answer (a frame, its Content-Type, Cache-Control: no-store), the cache, the shared in-flight fetch and the re-priming by fresh=1 CANNOT be reached here and are pinned in-process only (test/snapshotBehaviour.test.js). What this set does pin over real HTTP: authentication (401 for an anonymous request, plain and fresh), printer visibility (400 for the viewer on hidden Bravo, plain and fresh), the printer argument (out of range, not a number, missing: 400), and the failure answer 502 {\"error\":\"No camera frame: <name> has no camera\"} for Alpha, Bravo and offline Charlie, plain, repeated (a failure is not cached) and fresh — then the same after a configuration reload and after a restart. No printer is contacted by any of these requests; the printers' request logs are compared like every other side effect. Nothing here is declared volatile. Every request declares the status the fixture must produce (\"expect\"); a miss is an error of the run and fails verification.",
  "steps": [
    { "do": "login", "user": "admin", "password": "admin-pass-1" },
    { "do": "login", "user": "viewer", "password": "viewer-pass-1" },
    { "do": "request", "id": "snapshot-anon-401", "path": "/api/snapshot?printer=0", "expect": { "status": 401 } },
    { "do": "request", "id": "snapshot-anon-fresh-401", "path": "/api/snapshot?printer=0&fresh=1", "expect": { "status": 401 } },
    { "do": "request", "id": "snapshot-viewer-bravo-hidden-400", "path": "/api/snapshot?printer=1", "as": "viewer", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-viewer-bravo-hidden-fresh-400", "path": "/api/snapshot?printer=1&fresh=1", "as": "viewer", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-out-of-range-400", "path": "/api/snapshot?printer=9", "as": "admin", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-not-a-number-400", "path": "/api/snapshot?printer=abc", "as": "admin", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-missing-printer-400", "path": "/api/snapshot", "as": "admin", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-admin-alpha-no-camera-502", "path": "/api/snapshot?printer=0", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-admin-alpha-again-502", "path": "/api/snapshot?printer=0", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-admin-alpha-fresh-502", "path": "/api/snapshot?printer=0&fresh=1", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-viewer-alpha-no-camera-502", "path": "/api/snapshot?printer=0", "as": "viewer", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-admin-bravo-no-camera-502", "path": "/api/snapshot?printer=1", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-admin-charlie-offline-502", "path": "/api/snapshot?printer=2", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-admin-charlie-offline-fresh-502", "path": "/api/snapshot?printer=2&fresh=1", "as": "admin", "expect": { "status": 502 } },
    { "do": "reload", "id": "snapshot-config-reload", "as": "admin" },
    { "do": "request", "id": "snapshot-after-reload-alpha-502", "path": "/api/snapshot?printer=0", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-after-reload-alpha-fresh-502", "path": "/api/snapshot?printer=0&fresh=1", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-after-reload-charlie-offline-502", "path": "/api/snapshot?printer=2", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-after-reload-viewer-bravo-hidden-400", "path": "/api/snapshot?printer=1", "as": "viewer", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-after-reload-out-of-range-400", "path": "/api/snapshot?printer=9", "as": "admin", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-after-reload-anon-401", "path": "/api/snapshot?printer=0", "expect": { "status": 401 } },
    { "do": "restart", "id": "snapshot-server-restart" },
    { "do": "login", "user": "admin", "password": "admin-pass-1" },
    { "do": "login", "user": "viewer", "password": "viewer-pass-1" },
    { "do": "request", "id": "snapshot-after-restart-anon-401", "path": "/api/snapshot?printer=0", "expect": { "status": 401 } },
    { "do": "request", "id": "snapshot-after-restart-alpha-502", "path": "/api/snapshot?printer=0", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-after-restart-alpha-fresh-502", "path": "/api/snapshot?printer=0&fresh=1", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-after-restart-charlie-offline-502", "path": "/api/snapshot?printer=2", "as": "admin", "expect": { "status": 502 } },
    { "do": "request", "id": "snapshot-after-restart-viewer-bravo-hidden-400", "path": "/api/snapshot?printer=1", "as": "viewer", "expect": { "status": 400 } },
    { "do": "request", "id": "snapshot-after-restart-not-a-number-400", "path": "/api/snapshot?printer=abc", "as": "admin", "expect": { "status": 400 } }
  ]
}
